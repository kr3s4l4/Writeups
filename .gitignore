# ============================================
# REGLA PRINCIPAL: Ignorar todo por defecto
# ============================================
*

# ============================================
# PERMITIR SOLO ARCHIVOS .md (README.md)
# ============================================
!*.md
!**/*.md
!**/**/*.md
!**/**/**/*.md
!**/**/**/**/*.md

# ============================================
# PERMITIR CARPETAS QUE CONTIENEN README.md
# ============================================
!*/
!*/*/
!*/*/*/
!*/*/*/*/
!*/*/*/*/*/
!*/*/*/*/*/*/

# ============================================
# PERMITIR ARCHIVOS ESPECÍFICOS
# ============================================
!.gitignore
!README.md
!picoctf/README.md
!Rootme/README.md
!otros/README.md

# ============================================
# EXCLUIR ARCHIVOS NO DESEADOS
# ============================================
*.bak
*.txt.bak
*.jpg
*.png
*.jpeg
*.gif
*.bmp
*.ico
