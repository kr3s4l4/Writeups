# Ignorar todo por defecto
*

# Pero permitir archivos .md en cualquier nivel
!**/*.md

# Permitir README.md en la raíz
!README.md

# Permitir TODOS los README.md en Rootme (incluyendo subcarpetas)
!Rootme/**/README.md

# También permitir las carpetas que contienen README.md
!Rootme/*/

# Permitir el propio .gitignore
!.gitignore

# Opcional: excluir archivos de respaldo no deseados
*.bak
*.txt.bak
*.jpg
*.png
*.tar
*.gz
*.zip
*.deb
*.py
*.sh
__pycache__/
venv/
pixelenv/
corkami_collisions/
hashclash/
site-packages/
dist-info/
